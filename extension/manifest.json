{
  "manifest_version": 3,
  "name": "PersonaGuard",
  "version": "0.1.0",
  "description": "생성형 AI에 프롬프트를 입력할 때 개인정보 유출을 탐지·마스킹·재작성해주는 보안 도우미",
  "action": {
    "default_popup": "ui/result_panel.html",
    "default_title": "PersonaGuard"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "http://127.0.0.1:8000/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}